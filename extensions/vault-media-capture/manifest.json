{
  "manifest_version": 3,
  "name": "Vault Media Capture",
  "version": "1.0.0",
  "description": "Capture media URLs and smart-cropped images from sites you visit. Save downloaded files in Vault.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vault Media Capture",
    "default_popup": "popup.html"
  }
}
