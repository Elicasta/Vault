{
  "manifest_version": 3,
  "name": "Vault Media Capture",
  "version": "1.1.0",
  "description": "Use Venice and Perchance as real browser sites with Vault Studio saving beside them; capture images, video URLs and rendered media.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "storage",
    "clipboardWrite",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vault Media Capture",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "studio-panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vault-studio-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
