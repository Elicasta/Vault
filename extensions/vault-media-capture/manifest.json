{
  "manifest_version": 3,
  "name": "Vault — Save Links & Media",
  "version": "2.1.0",
  "description": "Save pages, links, YouTube videos, Google Drive shares, Pinterest pins, and galleries to your signed-in Vault account.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "webRequest",
    "storage",
    "clipboardWrite",
    "downloads",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vault Media Capture",
    "default_popup": "popup.html"
  }
}
